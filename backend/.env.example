# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control — it is in .gitignore.

DATABASE_URL=postgresql://pulse:CHANGE_ME@localhost:5432/pulse

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret

# Anthropic API key (for explain-svc)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

AUTH_SVC_URL=http://localhost:8001
INGESTION_SVC_URL=http://localhost:8002
FEATURE_SVC_URL=http://localhost:8003
ANOMALY_SVC_URL=http://localhost:8004
EXPLAIN_SVC_URL=http://localhost:8005

REDIS_URL=redis://localhost:6379/0

# Twilio SMS
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# DEV_MODE — set to true ONLY in local dev to expose OTPs in responses. MUST be false in prod.
DEV_MODE=false